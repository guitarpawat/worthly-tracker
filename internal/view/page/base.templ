package page

templ getPageHead(title string) {
    <head>
        <title>{title}</title>
        <link href="/css/main.css" rel="stylesheet" crossorigin="anonymous">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/bignumber.js@9/bignumber.js" crossorigin="anonymous"></script>
        <script src="https://unpkg.com/htmx.org@2" crossorigin="anonymous"></script>
        <script src="https://unpkg.com/htmx-ext-response-targets@2" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/gh/Emtyloc/json-enc-custom@main/json-enc-custom.js" crossorigin="anonymous"></script>
    </head>
}

func getHxExt() string {
    return "response-targets"
}